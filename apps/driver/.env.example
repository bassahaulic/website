# Copy to .env. Native Firebase config for Android lands in M1 via
# android/app/google-services.json (not committed); these values configure the
# JS side.

FIREBASE_PROJECT_ID=demo-haulpilot

# When "true", the driver app connects to the local Firebase emulators.
# Android emulator reaches the host machine at 10.0.2.2.
USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_URL=http://10.0.2.2:9099
FIRESTORE_EMULATOR_HOST=10.0.2.2:8080
STORAGE_EMULATOR_HOST=10.0.2.2:9199
